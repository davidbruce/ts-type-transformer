<interface name="AbortSignal">
  <extends type="EventTarget"/>
  <property name="aborted" type="boolean" readonly="true"/>
  <property name="onabort" type="((this: AbortSignal, ev: Event) =&gt; any) | null"/>
  <property name="reason" type="any" readonly="true"/>
  <method name="throwIfAborted">
    <returns type="void"/>
  </method>
  <method name="addEventListener">
    <typeParameter name="K" extends="&quot;abort&quot;"/>
    <parameter name="type" type="K"/>
    <parameter name="listener" type="(this: AbortSignal, ev: AbortSignalEventMap[K]) =&gt; any"/>
    <parameter name="options" type="boolean | AddEventListenerOptions | undefined" optional="true"/>
    <returns type="void"/>
  </method>
  <method name="addEventListener">
    <parameter name="type" type="string"/>
    <parameter name="listener" type="EventListenerOrEventListenerObject"/>
    <parameter name="options" type="boolean | AddEventListenerOptions | undefined" optional="true"/>
    <returns type="void"/>
  </method>
  <method name="removeEventListener">
    <typeParameter name="K" extends="&quot;abort&quot;"/>
    <parameter name="type" type="K"/>
    <parameter name="listener" type="(this: AbortSignal, ev: AbortSignalEventMap[K]) =&gt; any"/>
    <parameter name="options" type="boolean | EventListenerOptions | undefined" optional="true"/>
    <returns type="void"/>
  </method>
  <method name="removeEventListener">
    <parameter name="type" type="string"/>
    <parameter name="listener" type="EventListenerOrEventListenerObject"/>
    <parameter name="options" type="boolean | EventListenerOptions | undefined" optional="true"/>
    <returns type="void"/>
  </method>
  <method name="dispatchEvent">
    <parameter name="event" type="Event"/>
    <returns type="boolean"/>
  </method>
</interface>
<interface name="NodeListOf">
  <typeParameter name="TNode" extends="Node"/>
  <extends type="NodeList"/>
  <index key="number" type="TNode"/>
  <method name="item">
    <parameter name="index" type="number"/>
    <returns type="TNode"/>
  </method>
  <method name="forEach">
    <parameter name="callbackfn" type="(value: TNode, key: number, parent: NodeListOf&lt;TNode&gt;) =&gt; void"/>
    <parameter name="thisArg" type="any" optional="true"/>
    <returns type="void"/>
  </method>
  <method name="[Symbol.iterator]">
    <returns type="ArrayIterator&lt;TNode&gt;"/>
  </method>
  <method name="entries">
    <returns type="ArrayIterator&lt;[number, TNode]&gt;"/>
  </method>
  <method name="keys">
    <returns type="ArrayIterator&lt;number&gt;"/>
  </method>
  <method name="values">
    <returns type="ArrayIterator&lt;TNode&gt;"/>
  </method>
  <property name="length" type="number" readonly="true"/>
</interface>
<interface name="ReadableStream">
  <typeParameter name="R"/>
  <property name="locked" type="boolean" readonly="true"/>
  <method name="cancel">
    <parameter name="reason" type="any" optional="true"/>
    <returns type="Promise&lt;void&gt;"/>
  </method>
  <method name="getReader">
    <parameter name="options" type="{ mode: &quot;byob&quot;; }"/>
    <returns type="ReadableStreamBYOBReader"/>
  </method>
  <method name="getReader">
    <returns type="ReadableStreamDefaultReader&lt;R&gt;"/>
  </method>
  <method name="getReader">
    <parameter name="options" type="ReadableStreamGetReaderOptions | undefined" optional="true"/>
    <returns type="ReadableStreamReader&lt;R&gt;"/>
  </method>
  <method name="pipeThrough">
    <typeParameter name="T"/>
    <parameter name="transform" type="ReadableWritablePair&lt;T, R&gt;"/>
    <parameter name="options" type="StreamPipeOptions | undefined" optional="true"/>
    <returns type="ReadableStream&lt;T&gt;"/>
  </method>
  <method name="pipeTo">
    <parameter name="destination" type="WritableStream&lt;R&gt;"/>
    <parameter name="options" type="StreamPipeOptions | undefined" optional="true"/>
    <returns type="Promise&lt;void&gt;"/>
  </method>
  <method name="tee">
    <returns type="[ReadableStream&lt;R&gt;, ReadableStream&lt;R&gt;]"/>
  </method>
  <method name="[Symbol.asyncIterator]">
    <parameter name="options" type="ReadableStreamIteratorOptions | undefined" optional="true"/>
    <returns type="ReadableStreamAsyncIterator&lt;R&gt;"/>
  </method>
  <method name="values">
    <parameter name="options" type="ReadableStreamIteratorOptions | undefined" optional="true"/>
    <returns type="ReadableStreamAsyncIterator&lt;R&gt;"/>
  </method>
</interface>
<interface name="EventListenerObject">
  <method name="handleEvent">
    <parameter name="object" type="Event"/>
    <returns type="void"/>
  </method>
</interface>
