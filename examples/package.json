    "@types/three": "0.187.0",
    "date-fns": "4.4.0",
    "echarts": "6.1.0",
    "katex": "0.19.1",
    "konva": "10.9.1",
    "leaflet": "1.9.4",
    "marked": "18.2.0",
    "pixi.js": "8.23.0",
    "prosemirror-model": "1.25.13",
